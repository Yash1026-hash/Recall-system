@model VehicleRecall.Shared.Models.UserSummaryResponse

<div class="card user-summary">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
                <h2 class="h5 mb-1">@Model.FullName</h2>
                <p class="text-muted mb-0">@Model.Username &middot; @Model.Email</p>
            </div>
            <partial name="_UserStatus" model="Model" />
        </div>
        <div class="small text-muted mt-3">
            <span>@Model.Role</span>
            <span aria-hidden="true">&middot;</span>
            <span>@Model.Department</span>
        </div>
    </div>
</div>
