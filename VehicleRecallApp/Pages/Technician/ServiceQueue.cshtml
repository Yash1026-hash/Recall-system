@page
@model VehicleRecallApp.Pages.Technician.ServiceQueueModel

@{
    ViewData["Title"] = "Service Queue";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-page="/Technician/Dashboard" class="text-decoration-none">
                ← Back to Technician Dashboard
            </a>

            <h1 class="mt-3 mb-1">Today’s Service Queue</h1>
            <p class="text-muted mb-0">
                Scheduled recall repair jobs by bay and technician.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body border-bottom">
            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="BayFilter" class="form-label">Filter by Bay</label>
                        <select asp-for="BayFilter" class="form-select">
                            <option>All Bays</option>
                            <option>Bay 1</option>
                            <option>Bay 2</option>
                            <option>Bay 3</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="TechnicianFilter" class="form-label">Filter by Technician</label>
                        <select asp-for="TechnicianFilter" class="form-select">
                            <option>All Technicians</option>
                            <option>Ravi</option>
                            <option>Anita</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="QueueDate" class="form-label">Queue Date</label>
                        <input asp-for="QueueDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Time</th>
                        <th scope="col">Work Order</th>
                        <th scope="col">Customer / VIN</th>
                        <th scope="col">Campaign</th>
                        <th scope="col">Bay</th>
                        <th scope="col">Technician</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        <tr>
                            <td>@job.Time</td>
                            <td class="fw-semibold">@job.WorkOrderNumber</td>
                            <td>
                                <div>@job.CustomerName</div>
                                <small class="text-muted font-monospace">@job.Vin</small>
                            </td>
                            <td>@job.CampaignId</td>
                            <td>@job.Bay</td>
                            <td>@job.Technician</td>
                            <td>
                                @if (job.Status == "Scheduled")
                                {
                                    <span class="badge bg-secondary">Scheduled</span>
                                }
                                else if (job.Status == "Checked In")
                                {
                                    <span class="badge bg-primary">Checked In</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">In Progress</span>
                                }
                            </td>
                            <td>
                                <a asp-page="/Technician/WorkOrder"
                                    asp-route-workOrderNumber="@job.WorkOrderNumber"
                                        class="btn btn-sm btn-outline-primary">
                                    Open
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>