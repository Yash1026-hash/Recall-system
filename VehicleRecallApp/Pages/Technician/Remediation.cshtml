@page
@model VehicleRecallApp.Pages.Technician.RemediationModel

@{
    ViewData["Title"] = "Remediation Sign-Off";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="/Technician/WorkOrder"
           asp-route-workOrderNumber="@Model.Remediation.WorkOrderNumber"
           class="text-decoration-none">
            ← Back to Work Order
        </a>

        <h1 class="mt-3 mb-1">Remediation Sign-Off</h1>
        <p class="text-muted mb-0">
            Confirm that the recall repair was completed and verified.
        </p>

        @if (Model.SignedOff)
        {
            <div class="alert alert-success mt-3" role="alert">
                Repair @Model.Remediation.WorkOrderNumber was signed off successfully.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @Model.ErrorMessage
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h4 mb-3">Repair Summary</h2>

                    <dl class="row">
                        <dt class="col-sm-4">Work Order</dt>
                        <dd class="col-sm-8">@Model.Remediation.WorkOrderNumber</dd>

                        <dt class="col-sm-4">Customer</dt>
                        <dd class="col-sm-8">@Model.Remediation.CustomerName</dd>

                        <dt class="col-sm-4">VIN</dt>
                        <dd class="col-sm-8 font-monospace">@Model.Remediation.Vin</dd>

                        <dt class="col-sm-4">Campaign</dt>
                        <dd class="col-sm-8">@Model.Remediation.CampaignId</dd>
                    </dl>

                    <hr />

                    <form method="post">
                        <input type="hidden"
                               asp-for="Input.WorkOrderNumber"
                               value="@Model.Remediation.WorkOrderNumber" />

                    <h2 class="h5 mb-3">Completed Work</h2>

                    <p>
                        @Model.Remediation.RepairDescription
                    </p>

                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="repairPerformed"
                               asp-for="Input.RepairPerformed">

                        <label class="form-check-label" for="repairPerformed">
                            Recall repair was performed according to the repair instructions.
                        </label>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="qualityCheck"
                               asp-for="Input.QualityCheck">

                        <label class="form-check-label" for="qualityCheck">
                            Repair quality check and vehicle operation test were completed.
                        </label>
                    </div>

                    <div class="mb-3">
                        <label for="remediationNotes" class="form-label">
                            Remediation Notes
                        </label>

                        <textarea id="remediationNotes"
                                  class="form-control"
                                  rows="4"
                                  asp-for="Input.Notes"
                                  placeholder="Enter completion notes"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Sign Off Repair
                    </button>

                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Technician</h2>

                    <p class="mb-1 fw-semibold">
                        @Model.Remediation.TechnicianName
                    </p>

                    <p class="text-muted mb-0">
                        Assigned technician
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>