@page
@model VehicleRecallApp.Pages.Manager.DepartmentsModel

@{
    ViewData["Title"] = "Departments";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="/Manager/ControlRoom" class="text-decoration-none">&larr; User management</a>
        <h1 class="mt-3">Departments</h1>
        <p class="text-muted">Manage departments assigned to user accounts.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <partial name="_AlertMessage" model='new AlertMessageModel(successMessage, "success")' />
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <partial name="_AlertMessage" model='new AlertMessageModel(errorMessage, "danger")' />
    }
    @if (Model.ErrorMessage is not null)
    {
        <partial name="_AlertMessage" model='new AlertMessageModel(Model.ErrorMessage, "danger")' />
    }

    <section class="mb-5" aria-labelledby="department-list-heading">
        <h2 id="department-list-heading" class="h4">Department directory</h2>
        <div class="table-responsive border rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Name</th><th>Description</th><th>Users</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @if (Model.Departments.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No departments found.</td></tr>
                    }
                    else
                    {
                        @foreach (var department in Model.Departments)
                        {
                            <tr>
                                <td class="fw-semibold">@department.Name</td>
                                <td>@department.Description</td>
                                <td>@department.UserCount</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-page="/Manager/DepartmentDetails" asp-route-id="@department.DepartmentId" class="btn btn-sm btn-outline-secondary">Details</a>
                                        <a asp-page="/Manager/EditDepartment" asp-route-id="@department.DepartmentId" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@department.DepartmentId">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(department.UserCount > 0)">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section aria-labelledby="create-department-heading">
        <h2 id="create-department-heading" class="h4">Create department</h2>
        <form method="post" asp-page-handler="Create" class="card shadow-sm">
            <div class="card-body">
                <partial name="_ValidationSummary" model="Model" />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <input asp-for="Input.Description" class="form-control" />
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Create department</button>
            </div>
        </form>
    </section>
</div>
