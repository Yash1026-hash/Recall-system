@page
@model VehicleRecallApp.Pages.Manager.NotificationsModel

@{
    ViewData["Title"] = "Notification Dispatch";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-page="/Manager/Campaigns" class="text-decoration-none">
                ← Back to Campaigns
            </a>

            <h1 class="mt-3 mb-1">Notification Dispatch</h1>
            <p class="text-muted mb-0">
                Queue recall notifications for affected vehicle owners.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.CampaignId" class="form-label"></label>
                        <select asp-for="Input.CampaignId" class="form-select">
                            <option value="">Select a campaign</option>

                            @foreach (var campaign in Model.Campaigns)
                            {
                                <option value="@campaign.NhtsaId">
                                    @campaign.NhtsaId — @campaign.Description
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Input.CampaignId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Channel" class="form-label"></label>
                        <select asp-for="Input.Channel" class="form-select">
                            <option value="">Select a channel</option>
                            <option value="Email">Email</option>
                            <option value="SMS">SMS</option>
                            <option value="Email and SMS">Email and SMS</option>
                        </select>
                        <span asp-validation-for="Input.Channel" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Geography" class="form-label"></label>
                        <select asp-for="Input.Geography" class="form-select">
                            <option value="All regions">All regions</option>
                            <option value="North">North</option>
                            <option value="South">South</option>
                            <option value="East">East</option>
                            <option value="West">West</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.NotificationStatus" class="form-label"></label>
                        <select asp-for="Input.NotificationStatus" class="form-select">
                            <option value="Not notified">Not notified</option>
                            <option value="Notification failed">Notification failed</option>
                            <option value="Delivered">Delivered</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.MessageTemplate" class="form-label"></label>
                        <textarea asp-for="Input.MessageTemplate"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Example: Your vehicle has an active safety recall. Book a no-cost repair appointment using the secure link below."></textarea>

                        <div class="form-text">
                            Future placeholders: vehicle make, model, defect summary, and booking link.
                        </div>

                        <span asp-validation-for="Input.MessageTemplate" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Queue Notifications
                    </button>

                    <a asp-page="/Manager/Campaigns" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}