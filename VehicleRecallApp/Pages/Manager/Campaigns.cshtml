@page
@model VehicleRecallApp.Pages.Manager.CampaignsModel


@{
    ViewData["Title"] = "Recall Campaigns";
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Recall Campaigns</h1>
            <p class="text-muted mb-0">Select a campaign to review its customers and repair progress.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Manager/ControlRoom" class="btn btn-outline-primary">Manager Control Room</a>

            <a asp-page="/Manager/CreateCampaign" class="btn btn-primary">
                Create Campaign
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="card app-card shadow-sm">
        @if (Model.Campaigns.Count == 0)
        {
            <div class="p-4 text-muted">No campaigns have been created yet.</div>
        }
        else
        {
            @foreach (var campaign in Model.Campaigns)
            {
                     <a asp-page="/Manager/CampaignOverview"
                         asp-route-campaignId="@campaign.NhtsaId"
                         class="d-block border-bottom p-4 text-decoration-none text-reset campaign-list-item">
                    <div class="row align-items-center g-3 mb-3">
                        <div class="col-lg-5">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-bold text-primary">@campaign.NhtsaId</span>
                                <span class="badge rounded-pill bg-light text-dark">@campaign.Status</span>
                            </div>
                            <h2 class="h5 mb-1">@campaign.Description</h2>
                            <p class="text-muted mb-0">@campaign.AffectedComponent</p>
                        </div>

                        <div class="col-lg-2">
                            <div class="text-muted small">Severity</div>
                            <div class="fw-semibold">@campaign.Severity</div>
                        </div>

                        <div class="col-lg-2">
                            <div class="text-muted small">Affected VINs</div>
                            <div class="fw-semibold">@campaign.AffectedVins.ToString("N0")</div>
                        </div>

                        <div class="col-lg-3 text-lg-end">
                            <div class="text-muted small">Vehicles Done</div>
                            <div class="fw-semibold text-success">
                                @campaign.DoneVehicles / @campaign.TotalVehicles done
                            </div>
                            <div class="progress mt-1" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @campaign.CompletionPercentage%" aria-valuenow="@campaign.CompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="text-muted">@campaign.CompletionPercentage% completed</small>
                        </div>
                    </div>

                    <div class="small text-muted">@campaign.Users.Count affected customers · @campaign.AffectedVins.ToString("N0") affected VINs</div>
                </a>
            }
        }
    </div>
</div>
