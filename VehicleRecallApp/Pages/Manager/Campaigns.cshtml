@page
@model VehicleRecallApp.Pages.Manager.CampaignsModel


@{
    ViewData["Title"] = "Recall Campaigns";
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Recall Campaigns</h1>
            <p class="text-muted mb-0">Create and manage active safety recall campaigns.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Manager/Reports" class="btn btn-outline-primary">
                View Reports
            </a>

            <a asp-page="/Manager/Notifications" class="btn btn-outline-primary">
                Notifications
            </a>

            <a asp-page="/Manager/VinImport" class="btn btn-outline-primary">
                VIN Import Results
            </a>

            <a asp-page="/Manager/CreateCampaign" class="btn btn-primary">
                Create Campaign
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="card app-card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">NHTSA ID</th>
                        <th scope="col">Defect Summary</th>
                        <th scope="col">Severity</th>
                        <th scope="col">Affected VINs</th>
                        <th scope="col">Status</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var campaign in Model.Campaigns)
                    {
                        <tr>
                            <td class="fw-semibold">@campaign.NhtsaId</td>
                            <td>@campaign.Description</td>
                            <td>@campaign.Severity</td>
                            <td>@campaign.AffectedVins.ToString("N0")</td>
                            <td>@campaign.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
